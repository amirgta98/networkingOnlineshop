# ==============================================================================
# پیکربندی سرور Caddy برای دسترسی با دامنه رسمی (HTTPS خودکار) و آی‌پی مستقیم (HTTP)
# ==============================================================================

{
    email admin@fonix-accademic.ir
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# 1. دامنه رسمی همراه با گواهی SSL خودکار (HTTPS)
# ------------------------------------------------------------------------------
fonix-accademic.ir, www.fonix-accademic.ir {
    encode zstd gzip

    # هدایت درخواست‌های API به کانتینر بک‌اند NestJS
    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    # هدایت وب‌سوکت‌ها و درخواست‌های Socket.IO به بک‌اند NestJS
    handle /socket.io/* {
        reverse_proxy velox-backend-prod:3001
    }

    # هدایت مستندات Swagger
    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    # سرو مستقیم فایل‌های آپلود شده
    handle_path /uploads/* {
        root * /var/www/uploads
        try_files {path} /products/sample-router-1.webp
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    # هدایت تمام درخواست‌های دیگر به کانتینر فرانت‌اند Next.js
    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}

# ------------------------------------------------------------------------------
# 2. دسترسی مستقیم با آی‌پی سرور روی پورت 80 (HTTP)
# ------------------------------------------------------------------------------
:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /socket.io/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    handle_path /uploads/* {
        root * /var/www/uploads
        try_files {path} /products/sample-router-1.webp
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}
