# ==============================================================================
# پیکربندی جامع Caddy برای پاسخگویی همزمان به پورت 80 و 443
# بدون وابستگی به Let's Encrypt و کاملاً سازگار با ابرآروان و آی‌پی مستقیم
# ==============================================================================

{
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# 1. پورت 80 (HTTP خام)
# ------------------------------------------------------------------------------
:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /socket.io/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    handle_path /uploads/* {
        root * /var/www/uploads
        try_files {path} /products/sample-router-1.webp
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}

# ------------------------------------------------------------------------------
# 2. پورت 443 (HTTPS) با گواهی داخلی خودکار
# ------------------------------------------------------------------------------
:443 {
    tls internal
    encode zstd gzip

    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /socket.io/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    handle_path /uploads/* {
        root * /var/www/uploads
        try_files {path} /products/sample-router-1.webp
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}
