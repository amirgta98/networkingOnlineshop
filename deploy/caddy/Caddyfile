# ==============================================================================
# پیکربندی سرور Caddy برای پروداکشن پشت CDN ابرآروان و دسترسی مستقیم با آی‌پی
# ==============================================================================

{
    # غیرفعال کردن SSL خودکار چون گواهی SSL روی ابرآروان فعال است
    auto_https off
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# گوش دادن روی پورت 80 برای ترافیک ارسالی از ابرآروان و آی‌پی سرور
# ------------------------------------------------------------------------------
:80 {
    encode zstd gzip

    # هدایت درخواست‌های API به کانتینر بک‌اند NestJS
    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    # هدایت وب‌سوکت‌ها و درخواست‌های Socket.IO به بک‌اند NestJS
    handle /socket.io/* {
        reverse_proxy velox-backend-prod:3001
    }

    # هدایت مستندات Swagger
    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    # سرو مستقیم فایل‌های آپلود شده
    handle_path /uploads/* {
        root * /var/www/uploads
        try_files {path} /products/sample-router-1.webp
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    # هدایت تمام درخواست‌های دیگر به کانتینر فرانت‌اند Next.js
    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}
