# ==============================================================================
# پیکربندی سرور Caddy برای دسترسی مستقیم با آی‌پی سرور (یا دامنه)
# ==============================================================================

{
    # غیرفعال کردن موقت SSL خودکار تا زمان اتصال دامنه رسمی
    auto_https off
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# گوش دادن روی پورت 80 (HTTP) برای آی‌پی سرور یا دامنه
# ------------------------------------------------------------------------------
:80 {
    encode zstd gzip

    # هدایت درخواست‌های API به کانتینر بک‌اند NestJS
    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    # هدایت مستندات Swagger
    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    # سرو مستقیم فایل‌های آپلود شده
    handle_path /uploads/* {
        root * /var/www/uploads
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    # هدایت تمام درخواست‌های دیگر به کانتینر فرانت‌اند Next.js
    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}
