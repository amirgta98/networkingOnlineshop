# ==============================================================================
# پیکربندی سرور Caddy برای پشتیبانی همزمان HTTP و HTTPS با گواهی داخلی
# ==============================================================================

{
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# 1. ترافیک HTTP (پورت 80، دامنه و آی‌پی مستقیم)
# ------------------------------------------------------------------------------
:80, http://fonix-accademic.ir, http://www.fonix-accademic.ir {
    encode zstd gzip

    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /socket.io/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    handle_path /uploads/* {
        root * /var/www/uploads
        try_files {path} /products/sample-router-1.webp
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}

# ------------------------------------------------------------------------------
# 2. ترافیک HTTPS (پورت 443) با گواهی داخلی معتبر برای ارتباط امن با ابرآروان
# ------------------------------------------------------------------------------
https://fonix-accademic.ir, https://www.fonix-accademic.ir {
    tls internal
    encode zstd gzip

    handle /api/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /socket.io/* {
        reverse_proxy velox-backend-prod:3001
    }

    handle /api/docs* {
        reverse_proxy velox-backend-prod:3001
    }

    handle_path /uploads/* {
        root * /var/www/uploads
        try_files {path} /products/sample-router-1.webp
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    handle {
        reverse_proxy velox-frontend-prod:3000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}
