# ==============================================================================
# پیکربندی سرور Caddy برای دسترسی مستقیم با آی‌پی سرور (یا دامنه)
# ==============================================================================

{
    # غیرفعال کردن موقت SSL خودکار تا زمان خریداری و اتصال دامنه
    auto_https off
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# گوش دادن روی پورت 80 (HTTP) برای آی‌پی سرور یا دامنه
# ------------------------------------------------------------------------------
:80 {
    encode zstd gzip

    # هدایت درخواست‌های API به بک‌اند NestJS
    handle /api/* {
        reverse_proxy backend:3001 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # هدایت مستندات Swagger
    handle /api/docs* {
        reverse_proxy backend:3001 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # سرو مستقیم فایل‌های آپلود شده
    handle_path /uploads/* {
        root * /var/www/uploads
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    # هدایت تمام درخواست‌های دیگر به فرانت‌اند Next.js
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}
