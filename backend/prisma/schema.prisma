  portfolioId String    @map("portfolio_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text
  iconUrl     String?   @map("icon_url") @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
