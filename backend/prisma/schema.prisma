// ==========================================
// 16. SPECIAL OFFERS & CAMPAIGNS
// ==========================================

model SpecialOfferCampaign {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String             @db.VarChar(255)
  tagline     String?            @db.VarChar(255)
  description String?            @db.Text
  bannerUrl   String?            @map("banner_url") @db.Text
  startDate   DateTime           @map("start_date") @db.Timestamptz
  endDate     DateTime           @map("end_date") @db.Timestamptz
  status      CampaignStatus     @default(ACTIVE)
  priority    Int                @default(0)
  isPublished Boolean            @default(true) @map("is_published")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  items       SpecialOfferItem[]

  @@index([status, isPublished, priority], name: "idx_special_offers_display")
  @@index([startDate, endDate], name: "idx_special_offers_dates")
  @@map("special_offer_campaigns")
}

model SpecialOfferItem {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId    String               @map("campaign_id") @db.Uuid
  productId     String               @map("product_id") @db.Uuid
  discountType  DiscountType         @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal              @map("discount_value") @db.Decimal(15, 2)
  originalPrice Decimal?             @map("original_price") @db.Decimal(15, 2)
  specialPrice  Decimal              @map("special_price") @db.Decimal(15, 2)
  stockQuota    Int?                 @map("stock_quota")
  stockSold     Int                  @default(0) @map("stock_sold")
  maxPerOrder   Int?                 @default(5) @map("max_per_order")
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  campaign      SpecialOfferCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId], name: "uq_campaign_product")
  @@index([productId], name: "idx_special_offer_items_product")
  @@map("special_offer_items")
}

// ==========================================
// SUPPORT TICKET SYSTEM
// ==========================================

model Ticket {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber   String          @unique @map("ticket_number") @db.VarChar(30)
  userId         String          @map("user_id") @db.Uuid
  subject        String          @db.VarChar(255)
  department     TicketDepartment @default(GENERAL)
  priority       TicketPriority   @default(NORMAL)
  status         TicketStatus     @default(OPEN)
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz
  lastMessageAt  DateTime         @default(now()) @map("last_message_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       TicketMessage[]
  statusHistory  TicketStatusHistory[]

  @@index([userId, status], name: "idx_tickets_user_status")
  @@index([status, lastMessageAt(sort: Desc)], name: "idx_tickets_status_last_msg")
  @@index([createdAt(sort: Desc)], name: "idx_tickets_created_at")
  @@map("tickets")
}

model TicketMessage {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId        String           @map("ticket_id") @db.Uuid
  senderId        String           @map("sender_id") @db.Uuid
  senderRole      String           @map("sender_role") @db.VarChar(30) // user | admin | system
  content         String?          @db.Text
  messageType     TicketMessageType @default(TEXT) @map("message_type")
  clientMessageId String?          @unique @map("client_message_id") @db.VarChar(100) // idempotency
  isSystemMessage Boolean          @default(false) @map("is_system_message")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  ticket          Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender          User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments     TicketAttachment[]

  @@index([ticketId, createdAt], name: "idx_ticket_messages_ticket_created")
  @@map("ticket_messages")
}

model TicketAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  fileName    String   @map("file_name") @db.VarChar(255)
  storageKey  String   @map("storage_key") @db.VarChar(500)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  fileSize    Int      @map("file_size") // bytes
  url         String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  message     TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], name: "idx_ticket_attachments_message")
  @@map("ticket_attachments")
}

model TicketStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String       @map("ticket_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus @map("to_status")
  changedBy  String       @map("changed_by") @db.Uuid
  note       String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)], name: "idx_ticket_status_history")
  @@map("ticket_status_history")
}

// ==========================================
// 15. ARTICLES & PORTFOLIO MODULES
// ==========================================

model ArticleCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(150)
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  articles    Article[]

  @@index([isActive, sortOrder], name: "idx_article_categories_active_sort")
  @@map("article_categories")
}

model PortfolioCategory {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(100)
  slug        String      @unique @db.VarChar(150)
  description String?     @db.Text
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  portfolios  Portfolio[]

  @@index([isActive, sortOrder], name: "idx_portfolio_categories_active_sort")
  @@map("portfolio_categories")
}

model Tag {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String         @unique @db.VarChar(100)
  slug       String         @unique @db.VarChar(150)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  articles   ArticleTag[]
  portfolios PortfolioTag[]

  @@map("tags")
}

model Article {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String          @db.VarChar(255)
  slug             String          @unique @db.VarChar(255)
  excerpt          String          @db.Text
  content          String          @db.Text
  featuredImage    String?         @map("featured_image") @db.Text
  featuredImageAlt String?         @map("featured_image_alt") @db.VarChar(255)
  gallery          Json?
  videos           Json?
  categoryId       String?         @map("category_id") @db.Uuid
  authorName       String          @default("تیم فنی ققنوس آکادمی") @map("author_name") @db.VarChar(150)
  authorRole       String?         @map("author_role") @db.VarChar(150)
  authorAvatar     String?         @map("author_avatar") @db.Text
  authorId         String?         @map("author_id") @db.Uuid
  publishedAt      DateTime?       @map("published_at") @db.Timestamptz
  status           ContentStatus   @default(DRAFT)
  isFeatured       Boolean         @default(false) @map("is_featured")
  readTime         String?         @map("read_time") @db.VarChar(50)
  views            Int             @default(0)
  metaTitle        String?         @map("meta_title") @db.VarChar(255)
  metaDescription  String?         @map("meta_description") @db.Text
  focusKeyword     String?         @map("focus_keyword") @db.VarChar(150)
  seoKeywords      String?         @map("seo_keywords") @db.VarChar(500)
  canonicalUrl     String?         @map("canonical_url") @db.VarChar(500)
  ogTitle          String?         @map("og_title") @db.VarChar(255)
  ogDescription    String?         @map("og_description") @db.Text
  ogImage          String?         @map("og_image") @db.Text
  isIndexable      Boolean         @default(true) @map("is_indexable")
  isFollowable     Boolean         @default(true) @map("is_followable")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category         ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author           User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags             ArticleTag[]
  media            MediaAttachment[]

  @@index([status, isFeatured], name: "idx_articles_status_featured")
  @@index([categoryId], name: "idx_articles_category")
  @@index([publishedAt(sort: Desc)], name: "idx_articles_published_desc")
  @@index([createdAt(sort: Desc)], name: "idx_articles_created_desc")
  @@map("articles")
}

model ArticleTag {
  articleId String  @map("article_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Portfolio {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String                 @db.VarChar(255)
  slug               String                 @unique @db.VarChar(255)
  client             String?                @db.VarChar(255)
  location           String?                @db.VarChar(255)
  projectDate        String?                @map("project_date") @db.VarChar(100)
  summary            String                 @db.Text
  description        String                 @db.Text
  featuredImage      String?                @map("featured_image") @db.Text
  featuredImageAlt   String?                @map("featured_image_alt") @db.VarChar(255)
  gallery            Json?
  videos             Json?
  categoryId         String?                @map("category_id") @db.Uuid
  status             ContentStatus          @default(DRAFT)
  isFeatured         Boolean                @default(false) @map("is_featured")
  projectStatusLabel String?                @map("project_status_label") @db.VarChar(100)
  metaTitle          String?                @map("meta_title") @db.VarChar(255)
  metaDescription    String?                @map("meta_description") @db.Text
  focusKeyword       String?                @map("focus_keyword") @db.VarChar(150)
  seoKeywords        String?                @map("seo_keywords") @db.VarChar(500)
  canonicalUrl       String?                @map("canonical_url") @db.VarChar(500)
  ogTitle            String?                @map("og_title") @db.VarChar(255)
  ogDescription      String?                @map("og_description") @db.Text
  ogImage            String?                @map("og_image") @db.Text
  isIndexable        Boolean                @default(true) @map("is_indexable")
  isFollowable       Boolean                @default(true) @map("is_followable")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category           PortfolioCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               PortfolioTag[]
  features           PortfolioFeature[]
  challenges         PortfolioChallenge[]
  technologies       PortfolioTechnology[]
  achievements       PortfolioAchievement[]
  media              MediaAttachment[]

  @@index([status, isFeatured], name: "idx_portfolio_status_featured")
  @@index([categoryId], name: "idx_portfolio_category")
  @@index([createdAt(sort: Desc)], name: "idx_portfolio_created_desc")
  @@map("portfolios")
}

model PortfolioTag {
  portfolioId String    @map("portfolio_id") @db.Uuid
  tagId       String    @map("tag_id") @db.Uuid

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([portfolioId, tagId])
  @@map("portfolio_tags")
}

model PortfolioFeature {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  value       String    @db.VarChar(100)
  title       String    @db.VarChar(255)
  description String    @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, sortOrder], name: "idx_portfolio_features_sort")
  @@map("portfolio_features")
}

model PortfolioChallenge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  title       String    @db.VarChar(255)
  description String    @db.Text
  solution    String    @db.Text
  result      String    @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, sortOrder], name: "idx_portfolio_challenges_sort")
  @@map("portfolio_challenges")
}

model PortfolioTechnology {
