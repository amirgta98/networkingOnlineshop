  article      Article?   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  portfolio    Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([articleId, sortOrder], name: "idx_media_article_sort")
  @@index([portfolioId, sortOrder], name: "idx_media_portfolio_sort")
  @@map("media_attachments")
}

// ==========================================
// 21. ONLINE PAYMENT TRANSACTIONS (ZARINPAL)
// ==========================================

enum PaymentGatewayType {
  ZARINPAL_SANDBOX
  ZARINPAL
  SAMAN
  MELLAT
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentTargetType {
  ORDER
  WALLET
  INVOICE
}

model PaymentTransaction {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?             @map("user_id") @db.Uuid
  type         PaymentTargetType
  targetId     String              @map("target_id") @db.VarChar(100)
  amount       BigInt
  currency     String              @default("IRT") @db.VarChar(10)
  gateway      PaymentGatewayType  @default(ZARINPAL_SANDBOX)
  status       PaymentRecordStatus @default(PENDING)
  authority    String              @unique @db.VarChar(100)
  refId        String?             @map("ref_id") @db.VarChar(100)
  cardPan      String?             @map("card_pan") @db.VarChar(50)
  cardHash     String?             @map("card_hash") @db.VarChar(255)
  trackingCode String              @unique @map("tracking_code") @db.VarChar(100)
  description  String?             @db.Text
  callbackUrl  String?             @map("callback_url") @db.Text
  errorMessage String?             @map("error_message") @db.Text
  verifiedAt   DateTime?           @map("verified_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_payments_user_id")
  @@index([authority], name: "idx_payments_authority")
  @@index([targetId], name: "idx_payments_target_id")
  @@map("payment_transactions")
}

// ==========================================
// 22. AFFILIATE / PARTNER SYSTEM
// ==========================================

model AffiliateSettings {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  defaultDiscountPercent      Decimal   @default(8.00) @map("default_discount_percent") @db.Decimal(5, 2)
  defaultStaticIpCommission   BigInt    @default(150000) @map("default_static_ip_commission")
  defaultInternetCommission   BigInt    @default(400000) @map("default_internet_commission")
  isAffiliateSystemEnabled    Boolean   @default(true) @map("is_affiliate_system_enabled")
  isProductDiscountEnabled    Boolean   @default(true) @map("is_product_discount_enabled")
  isStaticIpCommissionEnabled Boolean   @default(true) @map("is_static_ip_commission_enabled")
  isInternetCommissionEnabled Boolean   @default(true) @map("is_internet_commission_enabled")
  eligibleProductIds          String[]  @default([]) @map("eligible_product_ids")
  eligibleCategoryIds         String[]  @default([]) @map("eligible_category_ids")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("affiliate_settings")
}

model AffiliatePartner {
  id                          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                      String                  @unique @map("user_id") @db.Uuid
  partnerCode                 String                  @unique @map("partner_code") @db.VarChar(50)
  status                      AffiliatePartnerStatus  @default(ACTIVE)
  customDiscountPercent       Decimal?                @map("custom_discount_percent") @db.Decimal(5, 2)
  customStaticIpCommission    BigInt?                 @map("custom_static_ip_commission")
  customInternetCommission    BigInt?                 @map("custom_internet_commission")
  isDiscountEnabled           Boolean                 @default(true) @map("is_discount_enabled")
  isCommissionEnabled         Boolean                 @default(true) @map("is_commission_enabled")
  totalSales                  BigInt                  @default(0) @map("total_sales")
  totalOrders                 Int                     @default(0) @map("total_orders")
  totalCommission             BigInt                  @default(0) @map("total_commission")
  paidCommission              BigInt                  @default(0) @map("paid_commission")
  approvedCommission          BigInt                  @default(0) @map("approved_commission")
  notes                       String?                 @db.Text
  joinedAt                    DateTime                @default(now()) @map("joined_at") @db.Timestamptz
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions                 AffiliateCommission[]
  payouts                     AffiliatePayout[]
  attributedOrders            Order[]                 @relation("OrderAffiliatePartner")

  @@index([status], name: "idx_affiliate_partners_status")
  @@index([partnerCode], name: "idx_affiliate_partners_code")
  @@map("affiliate_partners")
}

model AffiliateCommission {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId       String                    @map("partner_id") @db.Uuid
  orderId         String                    @map("order_id") @db.Uuid
  orderNumber     String                    @map("order_number") @db.VarChar(50)
  productType     String                    @map("product_type") @db.VarChar(50) // STATIC_IP, INTERNET
  productTitle    String                    @map("product_title") @db.VarChar(255)
  quantity        Int                       @default(1)
  unitCommission  BigInt                    @default(0) @map("unit_commission")
  totalCommission BigInt                    @default(0) @map("total_commission")
  status          AffiliateCommissionStatus @default(PENDING)
  notes           String?                   @db.Text
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partner         AffiliatePartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([partnerId], name: "idx_affiliate_commissions_partner_id")
  @@index([orderId], name: "idx_affiliate_commissions_order_id")
  @@index([status], name: "idx_affiliate_commissions_status")
  @@map("affiliate_commissions")
}

model AffiliatePayout {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId     String            @map("partner_id") @db.Uuid
  amount        BigInt
  trackingCode  String            @unique @map("tracking_code") @db.VarChar(100)
  paymentMethod String            @default("SATNA_PAYA") @map("payment_method") @db.VarChar(50)
  description   String?           @db.Text
  status        String            @default("COMPLETED") @db.VarChar(50)
  paidAt        DateTime          @default(now()) @map("paid_at") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  partner       AffiliatePartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId], name: "idx_affiliate_payouts_partner_id")
  @@map("affiliate_payouts")
}

// ==========================================
// 21. INSTALLATION & ENGINEERING REQUESTS
// ==========================================

model InstallationRequest {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackingCode         String             @unique @map("tracking_code") @db.VarChar(50)
  serviceType          String             @map("service_type") @db.VarChar(100)
  secondaryServices    Json?              @default("[]") @map("secondary_services")
  projectScale         String             @default("medium") @map("project_scale") @db.VarChar(50)
  buildingType         String             @default("office") @map("building_type") @db.VarChar(50)
  approximateArea      Int                @default(0) @map("approximate_area")
  nodeCount            Int                @default(0) @map("node_count")
  cctvCount            Int                @default(0) @map("cctv_count")
  rackCount            Int                @default(0) @map("rack_count")
  fiberCoreCount       Int                @default(0) @map("fiber_core_count")
  equipmentStatus      String             @default("need_purchase_from_netmarket") @map("equipment_status") @db.VarChar(100)
  needsFlukeTest       Boolean            @default(true) @map("needs_fluke_test")
  needsOnsiteSurvey    Boolean            @default(true) @map("needs_onsite_survey")
  preferredTimeline    String             @default("this_week") @map("preferred_timeline") @db.VarChar(50)
  province             String             @default("تهران") @db.VarChar(100)
  city                 String             @default("تهران") @db.VarChar(100)
  address              String             @db.Text
  fullName             String             @map("full_name") @db.VarChar(255)
  companyName          String?            @map("company_name") @db.VarChar(255)
  phoneNumber          String             @map("phone_number") @db.VarChar(50)
  email                String?            @db.VarChar(255)
  notes                String?            @db.Text
  hasAttachment        Boolean            @default(false) @map("has_attachment")
  attachmentName       String?            @map("attachment_name") @db.VarChar(255)
  attachmentUrl        String?            @map("attachment_url") @db.Text

  status               InstallationStatus @default(PENDING_REVIEW)
  estimatedDays        String?            @map("estimated_days") @db.VarChar(100)
  minEstimatedCost     BigInt             @default(0) @map("min_estimated_cost")
  maxEstimatedCost     BigInt             @default(0) @map("max_estimated_cost")
  finalQuotationAmount BigInt?            @map("final_quotation_amount")

  assignedTeamLead     String?            @map("assigned_team_lead") @db.VarChar(150)
  assignedTeamRole     String?            @map("assigned_team_role") @db.VarChar(150)
  assignedTeamPhone    String?            @map("assigned_team_phone") @db.VarChar(50)

  statusPercent        Int                @default(20) @map("status_percent")
  currentStepIndex     Int                @default(0) @map("current_step_index")
  trackingSteps        Json?              @default("[]") @map("tracking_steps")

  adminNotes           String?            @map("admin_notes") @db.Text

  userId               String?            @map("user_id") @db.Uuid
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([trackingCode], name: "idx_installation_tracking_code")
  @@index([phoneNumber], name: "idx_installation_phone_number")
  @@index([status], name: "idx_installation_status")
  @@index([userId], name: "idx_installation_user_id")
  @@map("installation_requests")
}





