datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TwoFactorMethod {
  PIN
  TOTP
  SMS
}

enum OrganizationMemberRole {
  OWNER
  CEO
  PURCHASING_MANAGER
  ACCOUNTANT
  TECHNICAL_MANAGER
  MEMBER
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  REJECTED
}

enum AddressType {
  CENTRAL_OFFICE
  CENTRAL_WAREHOUSE
  NETWORK_PROJECT_SITE
  PERSONAL_RESIDENCE
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  WITHDRAWAL
  CASHBACK
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  REFUND
  EXPIRE
  ADJUSTMENT
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CampaignStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
}

enum ProductRelationType {
  COMPATIBLE
  RELATED
  RECOMMENDED
  ALTERNATIVE
  ACCESSORY
}

enum InvoiceType {
  UNOFFICIAL
  OFFICIAL
}

enum InvoiceStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
}

enum InvoicePaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  PENDING_FINANCIAL
  PROCESSING_WAREHOUSE
  SHIPPING
  DELIVERED
  CANCELLED
}

enum RfqStatus {
  PENDING_QUOTE
  QUOTED
  EXPIRED
  CONVERTED
}

enum AuthenticityStatus {
  GENUINE
  COUNTERFEIT
  INVALID_CODE
  EXPIRED
}

enum AffiliatePartnerStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  READY_FOR_PAYMENT
  PAID
  CANCELLED
}

enum InstallationStatus {
  PENDING_REVIEW
  ASSIGNED
  SURVEY_SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ==========================================
// SUPPORT TICKET SYSTEM ENUMS
// ==========================================

enum TicketStatus {
  OPEN
  ANSWERED
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TicketDepartment {
  CISCO_SWITCHING
  FIBER_CABLING
  BILLING_LEGAL
  WARRANTY_RMA
  GENERAL
}

enum TicketMessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}


// ==========================================
// 2. USER, AUTHENTICATION & PROFILE
// ==========================================

model User {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                 String?                   @unique @db.VarChar(20)
  phoneVerifiedAt       DateTime?                 @map("phone_verified_at") @db.Timestamptz
  email                 String?                   @unique @db.VarChar(255)
  emailVerifiedAt       DateTime?                 @map("email_verified_at") @db.Timestamptz
  name                  String                    @db.VarChar(255) // Display/Full Name for quick access & backward compatibility
  status                UserStatus                @default(ACTIVE)
  isActive              Boolean                   @default(true) @map("is_active") // Backward compatibility with IUserRepository
  canBuyInternet        Boolean                   @default(false) @map("can_buy_internet")
  archivedAt            DateTime?                 @map("archived_at") @db.Timestamptz
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz


  // Subsystem Relations
  profile               UserProfile?
  security              UserSecurity?
  sessions              UserSession[]
  roles                 UserRoleMapping[]
  assignedRoles         UserRoleMapping[]         @relation("RoleAssignedBy")
  organizationMemberships OrganizationMember[]
  bankAccounts          UserBankAccount[]
  notificationSettings  UserNotificationSettings?
  addresses             UserAddress[]
  wallet                Wallet?
  loyaltyAccount        LoyaltyAccount?
  favorites             UserFavorite[]
  processedWithdrawals  WalletWithdrawal[]        @relation("WithdrawalProcessedBy")
  twoFactorChallenges   AuthTwoFactorChallenge[]

  // Catalog Relations
  reviews               ProductReview[]
  reviewLikes           ProductReviewLike[]

  // Invoices & Orders & Cart & Inquiries
  invoices              Invoice[]
  orders                Order[]
  cart                  Cart?
  rfqInquiries          RfqInquiry[]
  authenticityInquiries AuthenticityInquiry[]

  // Support Tickets
  tickets               Ticket[]
  ticketMessages        TicketMessage[]

  // Articles
  authoredArticles      Article[]

  // Online Payment Transactions
  paymentTransactions   PaymentTransaction[]

  // Affiliate / Partner System
  affiliateProfile      AffiliatePartner?

  // Installation Requests
  installationRequests  InstallationRequest[]

  @@index([status], name: "idx_users_status")
  @@index([createdAt(sort: Desc)], name: "idx_users_created_at_desc")
  @@map("users")
}

model UserProfile {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  firstName            String?  @map("first_name") @db.VarChar(100)
  lastName             String?  @map("last_name") @db.VarChar(100)
  nationalCode         String?  @unique @map("national_code") @db.VarChar(20) // Iranian National ID (10 digits with leading zero)
  nationalCodeVerified Boolean  @default(false) @map("national_code_verified")
  avatarUrl            String?  @map("avatar_url") @db.Text
  avatarStorageKey     String?  @map("avatar_storage_key") @db.VarChar(255)
  bio                  String?  @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSecurity {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String          @unique @map("user_id") @db.Uuid
  passwordHash         String?         @map("password_hash") @db.VarChar(255)
  securityPinHash      String?         @map("security_pin_hash") @db.VarChar(255) // Hashed 6-digit Security PIN for withdrawals
  pinFailedAttempts    Int             @default(0) @map("pin_failed_attempts")
  pinLockedUntil       DateTime?       @map("pin_locked_until") @db.Timestamptz
  twoFactorEnabled     Boolean         @default(false) @map("two_factor_enabled")
  twoFactorMethod      TwoFactorMethod @default(PIN) @map("two_factor_method")
  twoFactorSecret      String?         @map("two_factor_secret") @db.VarChar(255)
  lastPasswordChangedAt DateTime?      @map("last_password_changed_at") @db.Timestamptz
  lastPinChangedAt     DateTime?       @map("last_pin_changed_at") @db.Timestamptz
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_securities")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  deviceName       String?   @map("device_name") @db.VarChar(150)
  browser          String?   @db.VarChar(100)
  os               String?   @db.VarChar(100)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  location         String?   @db.VarChar(150)
  isRevoked        Boolean   @default(false) @map("is_revoked")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked, expiresAt], name: "idx_user_sessions_lookup")
  @@map("user_sessions")
}

model AuthOtpChallenge {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone               String    @db.VarChar(20)
  otpHash             String    @map("otp_hash") @db.VarChar(255)
  purpose             String    @default("LOGIN") @db.VarChar(50)
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5) @map("max_attempts")
  resendCooldownUntil DateTime  @map("resend_cooldown_until") @db.Timestamptz
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz
  ipAddress           String?   @map("ip_address") @db.VarChar(45)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([phone, consumedAt, expiresAt], name: "idx_otp_phone_valid")
  @@index([ipAddress, createdAt], name: "idx_otp_ip_rate_limit")
  @@map("auth_otp_challenges")
}

model AuthTwoFactorChallenge {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  phone       String    @db.VarChar(20)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt], name: "idx_2fa_user_valid")
  @@map("auth_two_factor_challenges")
}

// ==========================================
// 3. ROLE-BASED ACCESS CONTROL (RBAC)
// ==========================================

model Role {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique @db.VarChar(50) // CUSTOMER, PARTNER_B2B, STAFF_MANAGER, SUPER_ADMIN
  name        String            @db.VarChar(100)
  description String?           @db.Text
  isSystem    Boolean           @default(false) @map("is_system")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  permissions RolePermission[]
  users       UserRoleMapping[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(100) // articles:create, reviews:approve, orders:view
  module      String           @db.VarChar(50) // articles, reviews, orders, users, catalog, finance
  name        String           @db.VarChar(150)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  roles       RolePermission[]

  @@index([module], name: "idx_permissions_module")
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "uq_role_permission")
  @@map("role_permissions")
}

model UserRoleMapping {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner   User?    @relation("RoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId], name: "uq_user_role")
  @@map("user_roles")
}

// ==========================================
// 4. ORGANIZATIONS / LEGAL ENTITIES (B2B)
// ==========================================

model Organization {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName          String                 @map("legal_name") @db.VarChar(255)
  brandName          String?                @map("brand_name") @db.VarChar(255)
  economicCode       String?                @unique @map("economic_code") @db.VarChar(50) // 12-digit tax code
  nationalCompanyId  String?                @unique @map("national_company_id") @db.VarChar(50) // 11-digit legal national ID
  registrationNumber String?                @map("registration_number") @db.VarChar(50)
  establishedYear    String?                @map("established_year") @db.VarChar(10)
  companyType        String?                @map("company_type") @db.VarChar(50)
  officePhone        String?                @map("office_phone") @db.VarChar(50)
  officeAddress      String?                @map("office_address") @db.Text
  postalCode         String?                @map("postal_code") @db.VarChar(20)
  taxFileStatus      String?                @map("tax_file_status") @db.VarChar(50)
  creditLimit        Decimal                @default(0.00) @map("credit_limit") @db.Decimal(15, 2)
  creditBalance      Decimal                @default(0.00) @map("credit_balance") @db.Decimal(15, 2)
  status             OrganizationStatus     @default(PENDING_VERIFICATION)
  verifiedAt         DateTime?              @map("verified_at") @db.Timestamptz
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members            OrganizationMember[]

  @@index([status], name: "idx_organizations_status")
  @@map("organizations")
}

model OrganizationMember {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  role           OrganizationMemberRole @default(MEMBER)
  title          String?                @db.VarChar(100) // e.g. Purchasing Manager, CEO, CFO
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], name: "uq_org_member")
  @@map("organization_members")
}

// ==========================================
// 5. BANK ACCOUNTS
// ==========================================

model UserBankAccount {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  bankName          String             @map("bank_name") @db.VarChar(100)
  accountHolderName String             @map("account_holder_name") @db.VarChar(150)
  accountNumber     String?            @map("account_number") @db.VarChar(50)
  cardNumber        String?            @map("card_number") @db.VarChar(30)
  iban              String             @db.VarChar(34) // IR... format
  isVerified        Boolean            @default(false) @map("is_verified")
  isDefault         Boolean            @default(false) @map("is_default")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals       WalletWithdrawal[]

  @@index([userId], name: "idx_bank_accounts_user_id")
  @@map("user_bank_accounts")
}

// ==========================================
// 6. NOTIFICATION SETTINGS
// ==========================================

model UserNotificationSettings {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  orderShippingSms    Boolean  @default(true) @map("order_shipping_sms")
  officialInvoiceSms  Boolean  @default(true) @map("official_invoice_sms")
  newDeviceLoginAlert Boolean  @default(true) @map("new_device_login_alert")
  newsletter          Boolean  @default(false)
  emailNotifications  Boolean  @default(true) @map("email_notifications")
  pushNotifications   Boolean  @default(false) @map("push_notifications")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

// ==========================================
// 7. USER ADDRESSES
// ==========================================

model UserAddress {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  title              String      @db.VarChar(100)
  type               AddressType @default(CENTRAL_OFFICE)
  recipientFirstName String      @map("recipient_first_name") @db.VarChar(100)
  recipientLastName  String      @map("recipient_last_name") @db.VarChar(100)
  recipientMobile    String      @map("recipient_mobile") @db.VarChar(20)
  province           String      @db.VarChar(100)
  city               String      @db.VarChar(100)
  detailedAddress    String      @map("detailed_address") @db.Text
  plaque             String      @db.VarChar(30)
  unit               String?     @db.VarChar(30)
  postalCode         String      @map("postal_code") @db.VarChar(20)
  latitude           Decimal?    @db.Decimal(10, 7)
  longitude          Decimal?    @db.Decimal(11, 7)
  deliveryNotes      String?     @map("delivery_notes") @db.VarChar(500)
  isDefault          Boolean     @default(false) @map("is_default")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_addresses_user_id")
  @@map("user_addresses")
}

// ==========================================
// 8. FINANCIAL WALLET & TRANSACTIONS
// ==========================================

model Wallet {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @unique @map("user_id") @db.Uuid
  balance       Decimal             @default(0.00) @db.Decimal(15, 2)
  lockedBalance Decimal             @default(0.00) @map("locked_balance") @db.Decimal(15, 2)
  currency      String              @default("IRT") @db.VarChar(3)
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  withdrawals   WalletWithdrawal[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId      String                @map("wallet_id") @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(15, 2)
  balanceBefore Decimal               @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(15, 2)
  trackingCode  String                @unique @map("tracking_code") @db.VarChar(100)
  referenceType String?               @map("reference_type") @db.VarChar(50) // ORDER, GATEWAY_CHARGE, WITHDRAWAL, REFUND
  referenceId   String?               @map("reference_id") @db.VarChar(100)
  description   String?               @db.Text
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz

  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)], name: "idx_wallet_tx_history")
  @@map("wallet_transactions")
}

model WalletWithdrawal {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String           @map("wallet_id") @db.Uuid
  bankAccountId   String?          @map("bank_account_id") @db.Uuid
  cardNumber      String?          @map("card_number") @db.VarChar(30)
  shabaNumber     String?          @map("shaba_number") @db.VarChar(34)
  accountHolder   String?          @map("account_holder") @db.VarChar(150)
  bankName        String?          @map("bank_name") @db.VarChar(100)
  trackingCode    String?          @map("tracking_code") @db.VarChar(100)
  amount          Decimal          @db.Decimal(15, 2)
  status          WithdrawalStatus @default(PENDING)
  payoutReference String?          @map("payout_reference") @db.VarChar(100) // Satna/Paya tracking ID
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  requestedAt     DateTime         @default(now()) @map("requested_at") @db.Timestamptz
  processedAt     DateTime?        @map("processed_at") @db.Timestamptz
  processedBy     String?          @map("processed_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  bankAccount     UserBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  processor       User?            @relation("WithdrawalProcessedBy", fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([walletId, status], name: "idx_withdrawals_wallet_status")
  @@index([status], name: "idx_withdrawals_status")
  @@map("wallet_withdrawals")
}

// ==========================================
// 9. FAVORITES (WISHLIST)
// ==========================================

model UserFavorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], name: "uq_user_favorite")
  @@index([userId], name: "idx_favorites_user_id")
  @@map("user_favorites")
}

// ==========================================
// 10. LOYALTY & CUSTOMER CLUB
// ==========================================

model LoyaltyTier {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String               @unique @db.VarChar(50) // BRONZE, SILVER, GOLD, DIAMOND
  title           String               @db.VarChar(100)
  description     String?              @db.Text
  minPoints       Int                  @default(0) @map("min_points")
  cashbackPercent Decimal              @default(0.00) @map("cashback_percent") @db.Decimal(5, 2)
  sortOrder       Int                  @default(0) @map("sort_order")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  accounts        LoyaltyAccount[]
