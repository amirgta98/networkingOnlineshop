// ==========================================
// 12. PRODUCT MODULE
// ==========================================

model Product {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId               String              @map("brand_id") @db.Uuid
  categoryId            String              @map("category_id") @db.Uuid
  name                  String              @db.VarChar(255)
  slug                  String              @unique @db.VarChar(255)
  sku                   String?             @unique @db.VarChar(100)
  partNumber            String?             @map("part_number") @db.VarChar(100)
  shortDescription      String?             @map("short_description") @db.VarChar(500)
  fullDescription       String?             @map("full_description") @db.Text
  basePrice             Decimal             @map("base_price") @db.Decimal(15, 2)
  compareAtPrice        Decimal?            @map("compare_at_price") @db.Decimal(15, 2)
  currency              String              @default("IRT") @db.VarChar(3)
  status                ProductStatus       @default(DRAFT)
  isFeatured            Boolean             @default(false) @map("is_featured")
  hasOriginalWarranty   Boolean             @default(true) @map("has_original_warranty")
  isFreeExpressShipping Boolean             @default(false) @map("is_free_express_shipping")
  ratingAvg             Decimal             @default(0.00) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount           Int                 @default(0) @map("rating_count")
  archivedAt            DateTime?           @map("archived_at") @db.Timestamptz
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  brand                 Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                ProductImage[]
  options               ProductOption[]
  variants              ProductVariant[]
  discounts             ProductDiscount[]
  tieredDiscounts       ProductTieredDiscount[]
  specGroups            ProductSpecGroup[]
  expertReviews         ProductExpertReview[]
  deploymentScenarios   ProductDeploymentScenario[]
  reviews               ProductReview[]
  documents             ProductDocument[]
  favoritedBy           UserFavorite[]
  features              ProductFeature[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  specialOfferItems     SpecialOfferItem[]

  sourceRelations       ProductRelation[]   @relation("ProductSourceRelations")
  targetRelations       ProductRelation[]   @relation("ProductTargetRelations")

  @@index([status, isFeatured], name: "idx_products_status_featured")
  @@index([brandId], name: "idx_products_brand_id")
  @@index([categoryId], name: "idx_products_category_id")
  @@index([basePrice], name: "idx_products_base_price")
  @@index([createdAt(sort: Desc)], name: "idx_products_created_at_desc")
  @@index([status, categoryId, basePrice], name: "idx_products_catalog_query")
  @@map("products")
}

