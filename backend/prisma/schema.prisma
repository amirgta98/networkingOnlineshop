  quantity       Int      @default(1)
  unitPrice      BigInt   @default(0) @map("unit_price")
  totalPrice     BigInt   @default(0) @map("total_price")
  taxAmount      BigInt   @default(0) @map("tax_amount")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], name: "idx_invoice_items_invoice_id")
  @@map("invoice_items")
}

// ==========================================
// 12. CART & ACTIVE SHOPPING BAG
// ==========================================

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
