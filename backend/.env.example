PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velox_db?schema=public"

# Session & JWT Security
SESSION_SECRET="your-cryptographically-secure-random-secret-key-at-least-32-chars"
SESSION_COOKIE_NAME="velox_session_token"
SESSION_TTL_SECONDS=2592000
CORS_ORIGIN="http://localhost:3000"

# OTP Configuration
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
TWO_FACTOR_TTL_SECONDS=300

# Melipayamak Shared Line REST API (Flow B - Application-generated 5-digit OTP via Template)
# Documented in webservice-SharedNumber.pdf
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_OTP_BODY_ID=""

# Melipayamak Account-Specific Console OTP API (Flow A - Alternative Token endpoint)
# Format: https://console.melipayamak.com/api/send/otp/<token>
MELIPAYAMAK_OTP_API_KEY=""
