# ==============================================================================
# نمونه متغیرهای محیطی پروژه (Environment Variables Template)
# برای محیط پروداکشن، این فایل را با نام .env کپی کرده و مقادیر امن قرار دهید:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. تنظیمات پایگاه داده (PostgreSQL Database)
# ------------------------------------------------------------------------------
POSTGRES_DB=velox_db
POSTGRES_USER=velox_admin
# یک کلمه عبور قوی و تصادفی انتخاب کنید (مثلاً با دستور: openssl rand -base64 24)
POSTGRES_PASSWORD=change_this_to_a_very_strong_password_123!

# ------------------------------------------------------------------------------
# 2. تنظیمات بک‌اند (Backend - NestJS)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# آدرس اتصال به پایگاه داده در شبکه داخلی داکر
DATABASE_URL="postgresql://velox_admin:change_this_to_a_very_strong_password_123!@postgres:5432/velox_db?schema=public"

# کلید رمزنگاری توکن‌های JWT و نشست (بسیار مهم: غیرقابل حدس و محرمانه)
JWT_SECRET=your_super_secret_jwt_random_key_replace_me
SESSION_SECRET=your_super_secret_jwt_random_key_replace_me
SESSION_COOKIE_NAME=velox_session_token
SESSION_TTL_SECONDS=2592000

# تنظیمات اعتبار سنجی پیامکی و کد یک‌بار مصرف (OTP)
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
TWO_FACTOR_TTL_SECONDS=300

# وب‌سرویس پیامک ملی‌پیامک (وب‌سرویس خدماتی و پترن اشتراکی - BaseServiceNumber)
MELIPAYAMAK_USERNAME=9134761097
MELIPAYAMAK_PASSWORD=!Admin@2793
# شناسه عددی الگوی تایید پیامک (BodyId) که در پنل ملی‌پیامک تایید شده است
MELIPAYAMAK_OTP_BODY_ID=556130

# شناسه عددی الگوی اطلاع‌رسانی ثبت سفارش جدید به ادمین‌ها در سامانه ملی‌پیامک (Pattern 563237)
MELIPAYAMAK_ORDER_PATTERN_ID=563237

# شناسه عددی الگوی تایید ثبت سفارش به مشتری در سامانه ملی‌پیامک (Pattern 563239)
MELIPAYAMAK_CUSTOMER_ORDER_PATTERN_ID=563239

# شناسه عددی الگوی تحویل سفارش به پست/باربری در سامانه ملی‌پیامک (Pattern 546532)
MELIPAYAMAK_ORDER_SHIPPED_PATTERN_ID=546532

# اجبار ارسال واقعی پیامک در سرور پروداکشن (در سرور روی true تنظیم شود)
FORCE_REAL_SMS=true

# حالت ارسال کد تایید (SMS Delivery Mode) — بالاترین اولویت در تصمیم‌گیری سرور:
#   real     → ارسال واقعی پیامک از طریق API ملی‌پیامک (مقدار درست برای سرور)
#   telegram → شبیه‌سازی لوکال و ارسال کد به ربات تلگرام (فقط برای سیستم توسعه‌دهنده)
#   test     → بدون ارسال واقعی، فقط برای تست‌های خودکار
# اگر این متغیر خالی باشد، سرور به‌صورت خودکار در صورت وجود اطلاعات ملی‌پیامک، پیامک واقعی می‌فرستد.
SMS_DELIVERY_MODE=real

# وب‌سرویس کنسول ملی‌پیامک (console.melipayamak.com)
MELIPAYAMAK_OTP_API_KEY=35a1295420244314a52a34bbd2b0ed7b

# ربات تلگرام جهت دریافت کدهای OTP در محیط توسعه (Dev Mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# آدرس فرانت‌اند برای تنظیمات CORS
FRONTEND_URL=https://domain.ir
CORS_ORIGIN=https://domain.ir

# ------------------------------------------------------------------------------
# 3. تنظیمات فرانت‌اند (Frontend - Next.js)
# ------------------------------------------------------------------------------
# در صورت استفاده از ریورس‌پروکسی کدی (Caddy) که فرانت و بک روی یک IP یا دامنه هستند، مقدار زیر /api/v1 باشد
# در صورت داشتن ساب‌دامین اختصاصی بک‌اند، آدرس کامل مثل https://api.domain.ir/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# تنظیم امنیت کوکی نشست (اگر با IP یا HTTP تست می‌کنید false، و پس از نصب SSL روی دامنه true بگذارید)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. دامنه‌ها و تنظیمات SSL (Reverse Proxy - Caddy)
# ------------------------------------------------------------------------------
# دامنه اصلی فرانت‌اند (رکورد A در DNS به IP سرور وصل باشد)
FRONTEND_DOMAIN=domain.ir

# ساب‌دامین اختصاصی بک‌اند
BACKEND_DOMAIN=api.domain.ir

# ایمیل مدیر برای اطلاعیه‌های صدور و تمدید گواهی Let's Encrypt
ACME_EMAIL=admin@domain.ir

# ------------------------------------------------------------------------------
# 5. مشخصات تصاویر داکر در GitHub Container Registry (جهت CI/CD)
# ------------------------------------------------------------------------------
# نام کاربری گیت‌هاب (به حروف کوچک)
GITHUB_REPOSITORY_OWNER=your-github-username
